# Development backend examples:
#   iOS Simulator:     http://localhost:4000
#   Android Emulator: http://10.0.2.2:4000
# On a physical device, use your machine's LAN IP, e.g.:
#   EXPO_PUBLIC_API_URL=http://192.168.1.5:4000 npx expo start
# Production builds require an explicit HTTPS URL.
EXPO_PUBLIC_API_URL=http://localhost:4000

# Forced-upgrade destinations. Production config fails closed unless iOS uses
# a real apps.apple.com URL ending in its numeric /id… and Android targets this
# app package on play.google.com. Until the iOS listing exists, development
# safely falls back to an App Store search page.
EXPO_PUBLIC_IOS_APP_STORE_URL=
EXPO_PUBLIC_ANDROID_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.aienglish.coach

# Development ignores supplied AdMob IDs and uses Google's official samples.
# Production builds fail closed unless all six owner-created IDs are present,
# syntactically valid, non-Google-sample, and unique per platform/placement.
ADMOB_ANDROID_APP_ID=
ADMOB_IOS_APP_ID=
EXPO_PUBLIC_ADMOB_ANDROID_HOME_BANNER_ID=
EXPO_PUBLIC_ADMOB_IOS_HOME_BANNER_ID=
EXPO_PUBLIC_ADMOB_ANDROID_HISTORY_NATIVE_ID=
EXPO_PUBLIC_ADMOB_IOS_HISTORY_NATIVE_ID=
