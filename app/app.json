{
  "expo": {
    "name": "AI English Coach",
    "slug": "ai-english-coach",
    "scheme": "aienglishcoach",
    "platforms": ["ios", "android"],
    "version": "1.1.1",
    "icon": "./assets/icon-v2.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aienglish.coach",
      "buildNumber": "3",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.aienglish.coach",
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to record spoken English answers that you choose to submit for assessment.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#4F46E5"
        }
      ],
      "expo-asset",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon-v2.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/splash-icon-v2.png",
            "backgroundColor": "#0F1417"
          }
        }
      ],
      "react-native-google-mobile-ads",
      "expo-build-properties",
      "expo-localization"
    ],
    "locales": {
      "te": "./locales/te.json",
      "hi": "./locales/hi.json",
      "es": "./locales/es.json",
      "zh": "./locales/zh.json"
    }
  }
}
