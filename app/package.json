{
  "name": "app",
  "version": "1.1.1",
  "main": "expo-router/entry",
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "expo": "~57.0.18",
    "expo-asset": "~57.0.15",
    "expo-audio": "~57.0.4",
    "expo-build-properties": "~57.0.16",
    "expo-constants": "~57.0.16",
    "expo-crypto": "~57.0.2",
    "expo-file-system": "~57.0.6",
    "expo-haptics": "~57.0.2",
    "expo-linking": "~57.0.8",
    "expo-localization": "~57.0.1",
    "expo-network": "~57.0.1",
    "expo-notifications": "~57.0.16",
    "expo-router": "~57.0.17",
    "expo-secure-store": "~57.0.3",
    "expo-sharing": "~57.0.16",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-google-mobile-ads": "^16.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/parser": "7.29.8",
    "@babel/traverse": "7.29.8",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/jest-runner": "9.6.1",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "ajv": "6.15.0",
    "babel-jest": "29.7.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "expo-doctor": "1.20.1",
    "jest": "29.7.0",
    "jest-expo": "~57.0.5",
    "mutation-testing-report-schema": "3.7.3",
    "prettier": "3.9.6",
    "typescript": "~7.0.2"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "expo lint src __tests__ --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --runInBand --coverage",
    "test:quick": "jest --runInBand",
    "mutation": "npm run test:mutation-tooling && node scripts/run-mutation.mjs",
    "mutation:conditional-rendering": "node scripts/run-conditional-rendering-mutation.mjs",
    "mutation:event-handling": "node scripts/run-jsx-attribute-mutation.mjs --mode event",
    "mutation:accessibility": "node scripts/run-jsx-attribute-mutation.mjs --mode accessibility",
    "mutation:state": "node scripts/run-state-prop-mutation.mjs --mode state",
    "mutation:props": "node scripts/run-state-prop-mutation.mjs --mode prop",
    "mutation:lanes:verify": "node scripts/mutation-lanes.mjs",
    "test:mutation-tooling": "node --test scripts/test-mutation-lanes.mjs scripts/test-merge-mutation-reports.mjs scripts/test-recorder-killed-incremental-seed.mjs scripts/test-recorder-mutation-pass-merge.mjs scripts/test-run-recorder-mutation-passes.mjs scripts/test-conditional-rendering-mutation.mjs scripts/test-jsx-attribute-mutation.mjs scripts/test-state-prop-mutation.mjs",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor",
    "audit:ci": "node scripts/check-audit.mjs"
  },
  "jest": {
    "preset": "jest-expo",
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts"
    ],
    "coverageReporters": [
      "text",
      "json-summary"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 95,
        "branches": 88,
        "functions": 95,
        "lines": 99
      },
      "./src/components/Recorder.tsx": {
        "statements": 90,
        "branches": 85,
        "functions": 88,
        "lines": 99
      },
      "./src/lib/": {
        "statements": 98,
        "branches": 97,
        "functions": 97,
        "lines": 99
      }
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/\\.stryker-[^/]*tmp/"
    ]
  },
  "engines": {
    "node": "^22.13.0 || ^24.3.0",
    "npm": ">=10"
  },
  "overrides": {
    "metro": "0.84.5",
    "metro-config": "0.84.5",
    "metro-transform-worker": "0.84.5",
    "qs": "6.15.3"
  },
  "private": true
}
