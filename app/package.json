{
  "name": "app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "expo": "~57.0.13",
    "expo-asset": "~57.0.10",
    "expo-audio": "~57.0.3",
    "expo-constants": "~57.0.10",
    "expo-crypto": "~57.0.1",
    "expo-file-system": "~57.0.2",
    "expo-haptics": "~57.0.1",
    "expo-linking": "~57.0.6",
    "expo-notifications": "~57.0.11",
    "expo-router": "~57.0.13",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.12",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/jest-runner": "9.6.1",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.1",
    "expo-doctor": "1.20.1",
    "jest": "29.7.0",
    "jest-expo": "~57.0.4",
    "prettier": "3.9.6",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "expo lint src __tests__ --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --runInBand --coverage",
    "test:quick": "jest --runInBand",
    "mutation": "npm run test:mutation-tooling && node scripts/run-mutation.mjs",
    "mutation:lanes:verify": "node scripts/mutation-lanes.mjs",
    "test:mutation-tooling": "node --test scripts/test-mutation-lanes.mjs scripts/test-merge-mutation-reports.mjs",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor",
    "audit:ci": "node scripts/check-audit.mjs"
  },
  "jest": {
    "preset": "jest-expo",
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts"
    ],
    "coverageReporters": [
      "text",
      "json-summary"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 95,
        "branches": 88,
        "functions": 95,
        "lines": 99
      },
      "./src/components/Recorder.tsx": {
        "statements": 90,
        "branches": 85,
        "functions": 88,
        "lines": 99
      },
      "./src/lib/": {
        "statements": 98,
        "branches": 97,
        "functions": 97,
        "lines": 99
      }
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/\\.stryker-[^/]*tmp/"
    ]
  },
  "engines": {
    "node": "^22.13.0 || ^24.3.0",
    "npm": ">=10"
  },
  "overrides": {
    "qs": "6.15.3"
  },
  "private": true
}
