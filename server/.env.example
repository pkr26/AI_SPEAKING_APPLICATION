DATABASE_URL=postgres://localhost:5432/ai_english
# Required, min 32 chars, no default. Generate e.g. with: openssl rand -hex 32
JWT_SECRET=
OPENAI_API_KEY=
# true = simulated transcripts/scores, no OpenAI calls
MOCK_AI=true
PORT=4000
NODE_ENV=development
# Optional pino level: trace, debug, info, warn, error, fatal, or silent
LOG_LEVEL=debug
# Comma-separated allowlist of browser origins; empty = no browser CORS (mobile/curl unaffected)
CORS_ORIGINS=
# Exact number of reverse-proxy hops between clients and this API. Never use
# "true": trusting arbitrary X-Forwarded-For values bypasses IP rate limits.
TRUST_PROXY=0
# Keep well below the database's max_connections (stock PostgreSQL uses 100):
# a pool that can consume every connection locks out /ready, migrations, and
# admin clients. The server logs an error at boot when fewer than 3 server
# connections would remain.
DB_POOL_MAX=20
DB_STATEMENT_TIMEOUT_MS=10000
DB_LOCK_TIMEOUT_MS=5000
# Max assessed attempts per user per rolling 24h
ASSESS_DAILY_CAP=150
# Cross-account/provider budget circuit breaker per rolling 24h
ASSESS_GLOBAL_DAILY_CAP=5000
# Fixed-window daily assessment budget per source IP; bounds spend from
# account re-registration cycling. Must be >= ASSESS_DAILY_CAP.
ASSESS_IP_DAILY_CAP=300
AI_MAX_CONCURRENCY=10
# Per-process cap for native FFmpeg decoders; saturated requests fail fast.
AUDIO_INSPECTION_MAX_CONCURRENCY=4
OPENAI_TIMEOUT_MS=60000
# Structured-output model used to grade transcripts (rotate here on deprecation).
GRADING_MODEL=gpt-4o-mini-2024-07-18
# Graceful-shutdown drain budget (10s-300s). Boot refuses a value below the
# worst-case request budget (S3_OPERATION_TIMEOUT_MS + OPENAI_TIMEOUT_MS + 40s
# ingress margin, 130s with defaults) so a deploy never socket-kills the
# slowest legitimate assessment mid-flight.
SHUTDOWN_DRAIN_MS=140000
# Prometheus endpoint gate: true exposes GET /metrics (404 when false, the
# default). Enable it only where the route is scraped from a private network.
METRICS_ENABLED=false
# Oldest app version still served ("1.2.3"); clients sending a lower
# X-Client-Version get 426 CLIENT_UPGRADE_REQUIRED. Empty disables the gate.
MIN_CLIENT_VERSION=
# Password-reset delivery: log = write the mail (incl. the reset code) to the
# info log for dev/manual delivery; webhook = POST {to, subject, text} JSON to
# MAIL_WEBHOOK_URL (required in that mode) with a bounded timeout. Delivery is
# best-effort: failures are logged and the API response is unaffected.
# Production refuses to boot with MAIL_MODE=log (live reset tokens would land
# in logs and no mail would be delivered) and requires MAIL_WEBHOOK_URL to be
# https: (plain http: is accepted only for loopback hosts such as 127.0.0.1).
MAIL_MODE=log
MAIL_WEBHOOK_URL=
# Trusted FFmpeg executable used to decode/count audio before paid provider work.
FFMPEG_PATH=ffmpeg
# Trusted ffprobe executable used to count container audio streams before decode.
FFPROBE_PATH=ffprobe
RATE_LIMIT_GLOBAL_WINDOW_MS=900000
RATE_LIMIT_GLOBAL_MAX=300
# Counter store for the coarse global per-IP flood brake. memory (default)
# keeps it in-process: RATE_LIMIT_GLOBAL_MAX is a PER-REPLICA budget and busy
# traffic writes no counter rows. postgres shares one cluster-wide budget via
# the shared store. Security limiters (auth/login/register/assess/...) always
# use PostgreSQL. Keep an upstream WAF/edge limit for volumetric floods that
# should never reach the application either way.
RATE_LIMIT_GLOBAL_STORE=memory
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=20
# Cross-IP failed-login budget per normalized email. Only failures are
# throttled: a correct password always authenticates, and successful logins
# are refunded. Only an HMAC of the normalized address is stored in PostgreSQL.
RATE_LIMIT_LOGIN_ACCOUNT_WINDOW_MS=900000
RATE_LIMIT_LOGIN_ACCOUNT_MAX=10
# Per-account budget for password-confirmation routes (change-password,
# account deletion). Same always-verify shape: only failures are throttled.
RATE_LIMIT_PASSWORD_WINDOW_MS=900000
RATE_LIMIT_PASSWORD_MAX=10
# Per-IP budget for account creation: bounds bulk registration (account
# cycling, email enumeration) while leaving ordinary signups unaffected.
RATE_LIMIT_REGISTER_WINDOW_MS=3600000
RATE_LIMIT_REGISTER_MAX=10
# Per-target-email budget for password-reset requests across source IPs.
# Over-budget requests still answer 204 but silently stop issuing/sending, so
# the response never reveals throttling or account existence.
RATE_LIMIT_FORGOT_EMAIL_WINDOW_MS=3600000
RATE_LIMIT_FORGOT_EMAIL_MAX=5
RATE_LIMIT_ASSESS_WINDOW_MS=3600000
RATE_LIMIT_ASSESS_MAX=20
# Separate per-user budget for production S3 presigned POST issuance. A grant
# does not consume the paid assessment limiter; direct dev/test mode skips it.
RATE_LIMIT_UPLOAD_GRANT_WINDOW_MS=3600000
RATE_LIMIT_UPLOAD_GRANT_MAX=40
# Audio upload storage. Empty S3_BUCKET = local multipart-to-disk flow (dev/test
# only). Production requires a bucket: clients upload audio straight to S3 with
# size-constrained presigned POST grants; the API downloads it for assessment.
S3_BUCKET=
S3_REGION=us-east-1
# Optional static credentials; leave empty to use the AWS default provider
# chain (IAM role, shared config). The identity needs s3:PutObject,
# s3:GetObject and s3:DeleteObject on arn:aws:s3:::<bucket>/audio-uploads/*.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional only for temporary static credentials; requires both values above.
S3_SESSION_TOKEN=
S3_UPLOAD_URL_TTL_SECONDS=300
# Bounds GetObject body streaming and best-effort DeleteObject calls.
S3_OPERATION_TIMEOUT_MS=30000
