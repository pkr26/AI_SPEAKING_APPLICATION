{
  "name": "ai-english-server",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API for the AI English Learning app",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "db:setup": "tsx db/run.ts setup",
    "db:migrate": "tsx db/run.ts migrate",
    "db:migrate:prod": "node dist/db/run.js migrate",
    "db:catalog:prod": "node dist/db/run.js catalog",
    "db:preflight": "tsx db/preflight.ts",
    "db:preflight:prod": "node dist/db/preflight.js",
    "db:seed": "tsx db/run.ts seed",
    "db:generate-seed": "tsx db/generate-seed.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-db-assets.mjs",
    "start": "node dist/src/index.js",
    "smoke": "node scripts/smoke.mjs",
    "smoke:s3": "node scripts/live-s3-smoke.mjs",
    "smoke:concurrent": "node scripts/concurrent-smoke.mjs",
    "smoke:load1000": "node scripts/load-1000.mjs",
    "verify:load1000": "node scripts/verify-1000.mjs",
    "smoke:load1000:live": "node scripts/load-1000-live.mjs",
    "verify:load1000:live": "node scripts/verify-1000-live.mjs",
    "analyze:load1000:live": "node scripts/analyze-1000-live.mjs",
    "test": "vitest run --coverage",
    "test:quick": "vitest run",
    "mutation": "node scripts/run-mutation-all.mjs",
    "mutation:code": "tsx db/mutation-db-guard.ts && npm run test:mutation-tooling && node scripts/run-mutation-code.mjs",
    "mutation:catalog": "node scripts/run-mutation-catalog.mjs",
    "mutation:lanes:verify": "node scripts/mutation-lanes.mjs",
    "test:mutation-tooling": "node --test scripts/test-mutation-lanes.mjs scripts/test-mutation-campaign-lock.mjs scripts/test-mutation-process.mjs scripts/test-mutation-provenance.mjs scripts/test-merge-mutation-reports.mjs scripts/test-check-catalog-report.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": "^22.13.0 || ^24.3.0",
    "npm": ">=10"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1109.0",
    "@aws-sdk/s3-presigned-post": "^3.1109.0",
    "@aws-sdk/s3-request-presigner": "^3.1109.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "openai": "^4.77.0",
    "pg": "^8.13.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "qs": "6.15.3"
  }
}
