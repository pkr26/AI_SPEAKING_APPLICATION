{
  "name": "ai-english-server",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API for the AI English Learning app",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "db:setup": "tsx db/run.ts setup",
    "db:migrate": "tsx db/run.ts migrate",
    "db:migrate:prod": "node dist/db/run.js migrate",
    "db:preflight": "tsx db/preflight.ts",
    "db:preflight:prod": "node dist/db/preflight.js",
    "db:seed": "tsx db/run.ts seed",
    "db:seed:prod": "node dist/db/run.js seed",
    "db:generate-seed": "tsx db/generate-seed.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-db-assets.mjs",
    "start": "node dist/src/index.js",
    "smoke": "node scripts/smoke.mjs",
    "test": "vitest run --coverage",
    "test:quick": "vitest run",
    "mutation": "npm run mutation:code && npm run mutation:catalog",
    "mutation:code": "tsx db/mutation-db-guard.ts && stryker run",
    "mutation:catalog": "stryker run stryker.catalog.config.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": "^22.13.0 || ^24.3.0",
    "npm": ">=10"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1109.0",
    "@aws-sdk/s3-presigned-post": "^3.1109.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "openai": "^4.77.0",
    "pg": "^8.13.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "qs": "6.15.3"
  }
}
